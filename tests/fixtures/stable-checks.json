  "update": " update(){\n  if(!this.controls)return;\n  this.controls.poll();\n  const dir=this.controls.direction();if(!ui.open&&dir)this.player.step(dir);\n  this.player.sprite.setDepth(characterDepth(this.player.sprite.y));\n  const position=cameraPosition(this.player.sprite.x,this.player.sprite.y);\n  this.cameras.main.setScroll(Math.round(position.x),Math.round(position.y));\n  document.querySelector('#coordinates').textContent=`${String(this.player.x).padStart(2,'0')} · ${String(this.player.y).padStart(2,'0')}`;\n }",
  "action": "action=>{\n   if(action==='b'){ui.close();return;}\n   if(ui.open){ui.next();return;}\n   if(this.player.moving)return;\n   const [dx,dy]=directions[this.player.facing];\n   if(this.player.x+dx===npc.x&&this.player.y+dy===npc.y)ui.show();\n  },toggleDebug);",
  "dialogue": " return {\n  open:false,page:0,\n  pages:[\"Bienvenue à Bourg-Soleil ! Je suis Mila, la gardienne du village.\",\"Prends le temps d’explorer les chemins. La maison au toit de terre cuite est notre atelier.\",\"Les monstres viendront un jour… Pour l’instant, profite du calme de notre île !\"],\n  show(){this.open=true;this.page=0;this.render();},\n  next(){if(++this.page>=this.pages.length)this.close();else this.render();},\n  close(){this.open=false;document.querySelector('#dialogue').hidden=true;},\n  render(){document.querySelector('#speaker').textContent='Mila';document.querySelector('#message').textContent=this.pages[this.page];document.querySelector('#dialogue').hidden=false;},\n };\n}\n"
}
